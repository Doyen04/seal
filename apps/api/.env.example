# Copy to .env.local and fill in. Never commit real values.

# Neon pooled connection string (used by the running API)
DATABASE_URL=
# Neon direct (non-pooled) connection string (used for migrations)
DATABASE_URL_UNPOOLED=

# JSON map of key id to base64-encoded 32-byte key, e.g. {"k1":"<base64>"}
# Generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEYS=
# Key id from MASTER_KEYS used for new writes
MASTER_KEY_CURRENT=k1

# Origin of the web app (used for CORS and the CSRF origin check). On Vercel
# this is the one domain shared by both services in the project.
WEB_ORIGIN=http://localhost:3000

# Email (provider not chosen yet; see docs/DECISIONS.md)
EMAIL_FROM=

# Protects the cron endpoint
CRON_SECRET=

# Local dev server port
PORT=3001
