# Copy to .env.local and fill in.

# Base URL of the API service, WITHOUT the /v1 suffix. src/lib/server-api.ts
# appends /v1, which is the Hono app's basePath.
#
# Leave this unset on Vercel. The `api` service binding in the root vercel.json
# injects the API's internal URL into API_URL at request time. Set it here only
# for local development with `pnpm dev`.
API_URL=http://localhost:3001

# This app's own origin. Sent to the API as the Origin header on session
# requests, so it must exactly match WEB_ORIGIN in the API's settings.
WEB_ORIGIN=http://localhost:3000
